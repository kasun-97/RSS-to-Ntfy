# Copy to .env and fill in. Only RSS_URL and NTFY_CHANNEL are required.
# RSS_URL can be any RSS/Atom feed (e.g. a FreshRSS query feed).
RSS_URL=https://your-freshrss-instance/api/query.php
NTFY_CHANNEL=https://ntfy.sh/your-channel

# Optional
# NTFY_TOKEN=tk_xxxxxxxxxxxx
# NTFY_PRIORITY=3
# SEND_ON_FIRST_RUN=false
# MAX_DESCRIPTION_LENGTH=250
# REQUEST_TIMEOUT=10
# RETRY_ATTEMPTS=3
# RETRY_DELAY=2
# MAX_ENTRIES=50
# SEEN_LIMIT=500
